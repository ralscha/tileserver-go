{
  "listen": ":8080",
  "public_url": "",
  "base_path": "",
  "data_dir": "data",
  "allowed_hosts": ["localhost", "127.0.0.1", "[::1]"],
  "trust_proxy": false,
  "cors": {
    "origins": ["*"],
    "allow_credentials": false
  },
  "cache": {
    "size_mb": 256,
    "tile_max_age_seconds": 86400,
    "metadata_max_age_seconds": 300,
    "compress_vector_tiles": true
  },
  "database": {
    "max_connections": 8,
    "mmap_size_mb": 256,
    "page_cache_mb": 64
  },
  "http": {
    "read_header_timeout": "5s",
    "read_timeout": "15s",
    "write_timeout": "30s",
    "idle_timeout": "2m",
    "shutdown_timeout": "15s",
    "max_header_bytes": 1048576,
    "max_concurrent_requests": 4096
  },
  "observability": {
    "metrics": true,
    "access_log": true
  },
  "sources": {}
}
